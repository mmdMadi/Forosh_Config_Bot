# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_USER_IDS=123456789,987654321

# 3X-UI Panel Configuration (panel base URL, e.g. https://panel.example.com:2087)
PANEL_URL=https://panel.example.com:2087
PANEL_API_PATH=/your_secret_api_path
PANEL_USERNAME=admin
PANEL_PASSWORD=change_me
PANEL_API_TOKEN=your_api_token_here

# Subscription link port (usually the panel's subscription port)
PANEL_SUB_PORT=2096
